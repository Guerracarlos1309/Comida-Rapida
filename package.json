{
  "name": "fastfood-delivery-system",
  "version": "1.0.0",
  "description": "Sistema de Landing Page y Gestión de Pedidos Online para Negocios de Comida Rápida (Perros Calientes y Hamburguesas)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "install:all": "npm install; cd client; npm install",
    "dev": "concurrently \"npm run server\" \"npm run dev:client\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
